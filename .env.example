# Copy file này thành .env rồi dán API key của bạn vào:
#   cp .env.example .env
# Chỉ dùng MỘT luồng — dùng luồng nào thì bỏ comment các dòng của luồng đó.

# ===== LUỒNG CHÍNH: OpenAI (GPT-4o vs GPT-4o-mini) =====
OPENAI_API_KEY=sk-your-key-here

# ===== LUỒNG THAY THẾ: Google Gemini — dùng khi KHÔNG có key OpenAI =====
# Miễn phí (bậc free của Google AI Studio). Xem LAB_GUIDE.md, Phụ lục B.
# Lấy key tại https://aistudio.google.com/apikey rồi bỏ comment 4 dòng dưới
# (và comment/xóa dòng OPENAI_API_KEY ở trên):
# OPENAI_API_KEY=AIza-your-key-here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LAB_MODEL=gemini-2.5-flash
# LAB_MINI_MODEL=gemini-2.5-flash-lite

# ===== Lựa chọn khác: NVIDIA NIM — miễn phí (LAB_GUIDE.md, Phụ lục C) =====
# Lấy key tại https://build.nvidia.com rồi bỏ comment 4 dòng dưới:
# OPENAI_API_KEY=nvapi-your-key-here
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# LAB_MODEL=meta/llama-3.3-70b-instruct
# LAB_MINI_MODEL=meta/llama-3.1-8b-instruct
